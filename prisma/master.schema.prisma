// prisma/master.schema.prisma

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/master-client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["master"]
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logoUrl       String?
  dbUrl         String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  subscription  Subscription?
  apiKeys       ApiKey[]
  auditLogs     MasterAuditLog[]

  @@schema("master")
}

model Subscription {
  id             String           @id @default(cuid())
  organizationId String           @unique
  plan           SubscriptionPlan @default(FREE)
  status         String           @default("active")
  expiresAt      DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id])

  @@schema("master")
}

model ApiKey {
  id             String       @id @default(cuid())
  key            String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@schema("master")
}

model MasterAuditLog {
  id             String       @id @default(cuid())
  organizationId String?
  action         String
  details        Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@schema("master")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  password       String?
  role           Role      @default(OPERATOR)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@schema("master")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
  CUSTOMER

  @@schema("master")
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE

  @@schema("master")
}
